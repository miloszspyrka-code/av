{
    "name": "alphavault/mcp",
    "description": "AlphaVault MCP resource server and OAuth 2.1 authorization server",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "laminas/laminas-httphandlerrunner": "^2.12",
        "league/oauth2-server": "^9.4",
        "mcp/sdk": "^0.10",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "AlphaVault\\": "app/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test:mcp": "php tests/mcp.e2e.php"
    }
}
