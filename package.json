{
  "name": "alpha-vault",
  "version": "4.0.0",
  "private": true,
  "description": "Alpha Vault — PHP 8.3 backend, MySQL, Discord OAuth2",
  "scripts": {
    "test": "node tests/api.e2e.mjs",
    "test:prop": "node tests/prop.unit.mjs",
    "test:router": "node tests/router.unit.mjs",
    "test:ui": "node tests/ui.e2e.mjs",
    "test:ui:empty": "node tests/ui-empty.e2e.mjs",
    "test:tax": "node tests/tax.e2e.mjs",
    "test:events": "php tests/discord-events.test.php",
    "test:macro": "php tests/macro-events.test.php",
    "test:quotes": "php tests/quotes.test.php",
    "test:demo-state": "php tests/demo-state.test.php",
    "test:quotes:e2e": "node tests/quotes.e2e.mjs",
    "test:roles": "php tests/role-guard.test.php && node tests/role-recheck.e2e.mjs",
    "test:wearables": "node tests/wearables.e2e.mjs",
    "test:mcp": "node tests/mcp.e2e.mjs",
    "test:mcp:login": "node tests/mcp-login.e2e.mjs",
    "test:mcp:ui": "node tests/mcp-ui.e2e.mjs",
    "test:mcp:prop": "node tests/prop-parity.mjs",
    "test:docs": "node tests/docs.test.mjs",
    "test:encoding": "node tests/encoding.test.mjs && node scripts/check-encoding.mjs",
    "test:isolation": "node tests/isolation.e2e.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "test:all": "node tests/prop.unit.mjs && node tests/api.e2e.mjs && node tests/isolation.e2e.mjs && node tests/ui.e2e.mjs && node tests/pwa.e2e.mjs",
    "test:pwa": "node tests/pwa.e2e.mjs",
    "test:integrations": "node tests/integrations.e2e.mjs",
    "test:ui:integrations": "node tests/ui-integrations.e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.57.0"
  }
}
